---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Skill from '../components/Skill.astro';
import Methodology from '../components/Methodology.astro';
import Footer from '../components/Footer.astro';
import T from '../components/T.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---
<Base title="/analyst-research · Gen">
  <Nav />
  <main>
    <div class="max-w-6xl mx-auto px-6 pt-8">
      <a href={asset('#skills')} class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)] transition inline-flex items-center gap-1.5">
        <span aria-hidden="true">←</span> <T en="Market Research plugin" zh="Market Research plugin" />
      </a>
    </div>
    <Skill />
    <Methodology />

    <!-- Example CTA -->
    <section class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule)]">
      <div class="max-w-6xl mx-auto px-6 py-16 md:py-20 text-center">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight mb-4">
          <T en="See what it produces." zh="看看它能产出什么。" />
        </h2>
        <p class="text-[var(--color-muted)] leading-relaxed max-w-xl mx-auto mb-8">
          <T en="A 15,000-word Saudi Vision 2030 deep-dive, built end-to-end in heavy mode." zh="一份用 heavy mode 端到端跑出来的 1.5 万字沙特愿景 2030 深度研究。" />
        </p>
        <a
          href={asset('#case')}
          class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--color-ink)] text-[var(--color-paper)] rounded font-medium hover:bg-[var(--color-brand)] transition"
        >
          <T en="View the example report" zh="查看示例报告" />
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Base>

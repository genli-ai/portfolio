---
import T from './T.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

// Data-driven catalog. Add a future skill by appending an entry here.
const skills = [
  {
    featured: true,
    name: "/analyst-research",
    descEn: "Turns a hypothesis into a publication-ready research report — three scope modes, one rigorous 8-step workflow.",
    descZh: "把一个假设做成可发表的研究报告——三档 mode，一套严谨的 8 步工作流。",
    tags: ["3 modes", "8-step"],
    href: asset("analyst-research"),
  },
  {
    name: "/verifying",
    descEn: "Fact-checks any claim against whitelisted primary sources only — out-of-context quotes, one-level decomposition (Z = P × Q), conflicting sources side by side.",
    descZh: "把任何说法只拿去跟白名单原始来源核对——断章取义、一层拆解（Z = P × Q）、多源冲突并排。",
    tags: ["primary sources", "5 scenarios"],
    href: asset("verifying"),
  },
  {
    name: "/topic-brief",
    descEn: "Turns public news into a focused topic briefing — a self-contained HTML page, styled for the browser and one-click paste into WeChat.",
    descZh: "把公开新闻做成聚焦的主题简报——独立 HTML 页面，适合浏览器看，也能一键贴进公众号。",
    tags: ["news", "HTML", "WeChat"],
    href: asset("topic-brief"),
  },
];
---
<section id="skills" class="bg-[var(--color-paper-warm)] border-y border-[var(--color-rule)]">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">

    <div class="max-w-3xl mb-10">
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--color-accent)] mb-4">
        <T en="Market Research · one plugin, three skills" zh="Market Research · 一个 plugin，三个 skill" />
      </div>
      <h2 class="text-3xl md:text-5xl font-semibold tracking-tight leading-tight mb-6">
        <T en="The Market Research<br />plugin." zh="Market Research<br />plugin。" />
      </h2>
      <p class="text-lg text-[var(--color-muted)] leading-relaxed">
        <T
          en="Three composable skills for the investment-research loop — research, verify, brief. Open-source, MIT, installable in Claude Code. Open any card for the deep dive."
          zh="投研闭环里的三个可组合 skill——做研究、核事实、写简报。开源 MIT，可在 Claude Code 里直接安装。点开任意一张卡看深度介绍。"
        />
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {skills.map(s => (
        <a
          href={s.href}
          class={`group flex flex-col p-6 rounded-lg border bg-white hover:shadow-lg transition ${s.featured ? "border-[var(--color-ink)]" : "border-[var(--color-rule)]"}`}
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-sm font-semibold text-[var(--color-brand)]">{s.name}</span>
            {s.featured && (
              <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded-full bg-[var(--color-accent)] text-white">
                <T en="Featured" zh="精选" />
              </span>
            )}
          </div>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4 flex-1">
            <T en={s.descEn} zh={s.descZh} />
          </p>
          <div class="flex flex-wrap gap-1.5 mb-4">
            {s.tags.map(tag => (
              <span class="text-[10px] font-mono px-2 py-0.5 rounded border border-[var(--color-rule)] text-[var(--color-muted)]">{tag}</span>
            ))}
          </div>
          <span class="text-sm font-medium text-[var(--color-ink)] inline-flex items-center gap-1.5">
            <T en="See details" zh="查看详情" /> <span class="text-[var(--color-accent)] group-hover:translate-x-0.5 transition-transform" aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>

  </div>
</section>

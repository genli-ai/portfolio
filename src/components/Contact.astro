---
import T from './T.astro';
const links = [
  { labelEn: "Email", labelZh: "邮箱", value: "ligen.thu@gmail.com", href: "mailto:ligen.thu@gmail.com" },
  { labelEn: "LinkedIn", labelZh: "LinkedIn", value: "linkedin.com/in/gen-li1993", href: "https://www.linkedin.com/in/gen-li1993/" },
  { labelEn: "GitHub", labelZh: "GitHub", value: "github.com/reagan475614947", href: "https://github.com/reagan475614947" },
];
---
<section id="contact" class="bg-[var(--color-paper-warm)]">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">

    <div class="max-w-3xl">
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--color-accent)] mb-4">
        <T en="Contact" zh="联系" />
      </div>
      <h2 class="text-3xl md:text-5xl font-semibold tracking-tight leading-tight mb-6">
        <T en="Let's talk." zh="聊聊吧。" />
      </h2>
      <p class="text-lg text-[var(--color-muted)] leading-relaxed mb-10">
        <T
          en="Building AI workflows for investment research, or wondering whether this skill could slot into your own process? Reach out — the source is open, and I'm always glad to trade notes."
          zh="也在做投研方向的 AI 工作流，或者想看看这个 skill 能不能接进自己的流程？都欢迎找我聊——源码是公开的，我也很乐意交换想法。"
        />
      </p>

      <dl class="space-y-3 font-mono text-sm">
        {links.map(l => (
          <div class="grid grid-cols-[120px_1fr] gap-4 py-3 border-t border-[var(--color-rule)]">
            <dt class="text-[var(--color-muted)] uppercase tracking-wider text-xs pt-0.5"><T en={l.labelEn} zh={l.labelZh} /></dt>
            <dd>
              <a href={l.href} class="text-[var(--color-ink)] hover:text-[var(--color-accent)] transition" target="_blank" rel="noopener">{l.value}</a>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

---
import T from './T.astro';
import SectionHeader from './SectionHeader.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const tools = [
  { name: "/analyst-research", href: asset('analyst-research'),
    en: "Hypothesis → publication-grade report. Source-disciplined, end to end.",
    zh: "假设 → 出版级报告。全程来源纪律。" },
  { name: "/verifying", href: asset('verifying'),
    en: "Every claim traced back to a whitelisted primary source.",
    zh: "每个论断都追溯到白名单一手来源。" },
  { name: "/topic-brief", href: asset('topic-brief'),
    en: "Public signal → a clean, shareable briefing.",
    zh: "公开信号 → 干净可分享的简报。" },
  { name: "/local-vault", href: asset('local-vault'),
    en: "Your files → a clean Markdown vault, answered with discipline.",
    zh: "你的文件 → 干净的 Markdown 库，以检索纪律作答。" },
];
---
<section id="skills" class="relative overflow-hidden bg-[var(--color-brand-deep)] text-white border-b border-black/10">
  <div class="pointer-events-none absolute -top-32 -right-40 w-[520px] h-[520px] rounded-full opacity-[0.12]"
       style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"></div>

  <div class="relative max-w-[920px] mx-auto px-7 py-20 md:py-28">
    <SectionHeader dark num="02" kickerEn="What I build" kickerZh="我造过什么" titleEn="My AI skills" titleZh="我的 AI 产品" />
    <p class="text-[15px] md:text-base text-white/65 leading-relaxed mt-4 mb-10">
      <T
        en="Open-source AI products I designed and shipped. I don't just analyze AI — I build it."
        zh="我设计并发布的开源 AI 产品。我不只分析 AI——我亲手造它。"
      />
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-9">
      {tools.map((t) => (
        <a href={t.href} class="group flex flex-col rounded-lg p-5 bg-white/[0.04] border border-white/12 transition duration-300 hover:bg-white/[0.07] hover:border-[var(--color-accent-soft)]/60">
          <div class="font-serif text-[16px] text-[var(--color-accent-soft)] mb-2">{t.name}</div>
          <div class="text-[13.5px] text-white/70 leading-relaxed flex-1"><T en={t.en} zh={t.zh} /></div>
          <div class="mt-4 text-[13px] font-medium text-white inline-flex items-center gap-1">
            <T en="Open" zh="查看" /> <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <a href={asset('skills')} class="group inline-flex items-center gap-2 text-[14px] font-medium text-[var(--color-accent-soft)] hover:text-white transition-colors">
      <T en="Explore my AI skills" zh="了解我的 AI 产品" />
      <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span>
    </a>
  </div>
</section>

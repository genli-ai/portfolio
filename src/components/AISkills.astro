---
import T from './T.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const tools = [
  { name: "/analyst-research", href: asset('analyst-research'),
    en: "Hypothesis → publication-grade report. Source-disciplined, end to end.",
    zh: "假设 → 出版级报告。全程来源纪律。" },
  { name: "/verifying", href: asset('verifying'),
    en: "Every claim traced back to a whitelisted primary source.",
    zh: "每个论断都追溯到白名单一手来源。" },
  { name: "/topic-brief", href: asset('topic-brief'),
    en: "Public signal → a clean, shareable briefing.",
    zh: "公开信号 → 干净可分享的简报。" },
];
---
<section id="skills" class="bg-[var(--color-paper-warm)] border-b border-[var(--color-rule)]">
  <div class="max-w-[920px] mx-auto px-7 py-20 md:py-24">

    <div class="text-[11px] font-medium uppercase tracking-[0.18em] text-[var(--color-accent)] mb-3">
      <T en="What I've built" zh="我造过什么" />
    </div>
    <h2 class="font-serif text-[30px] md:text-[34px] font-semibold tracking-tight mb-3"><T en="My AI skills" zh="我的 AI 产品" /></h2>
    <p class="text-[15px] md:text-base text-[var(--color-muted)] leading-relaxed mb-9 max-w-[58ch]">
      <T
        en="Open-source AI products I designed and shipped. I don't just analyze AI — I build it."
        zh="我设计并发布的开源 AI 产品。我不只分析 AI——我亲手造它。"
      />
    </p>

    <div class="grid sm:grid-cols-3 gap-4 mb-7">
      {tools.map((t) => (
        <a href={t.href} class="group flex flex-col bg-white border border-[var(--color-rule)] rounded-xl p-5 hover:border-[var(--color-brand)]/50 hover:shadow-[0_8px_30px_-12px_rgba(47,93,80,0.22)] transition">
          <div class="font-serif text-[16px] text-[var(--color-brand)] mb-2">{t.name}</div>
          <div class="text-[13.5px] text-[var(--color-ink-soft)] leading-relaxed flex-1"><T en={t.en} zh={t.zh} /></div>
          <div class="mt-4 text-[13px] font-medium text-[var(--color-brand)] inline-flex items-center gap-1">
            <T en="Open" zh="查看" /> <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <p class="font-serif italic text-[var(--color-ink-soft)] text-[15px] md:text-base mb-5 max-w-[58ch]">
      <T
        en="Building these is how I read AI from the inside — not just the outside."
        zh="正因为造过这些，我能从内部读懂 AI，而不只从外部观察。"
      />
    </p>
    <a href="https://github.com/genli-ai/market-research-skills" target="_blank" rel="noopener"
       class="text-[13px] text-[var(--color-muted)] hover:text-[var(--color-brand)] transition inline-flex items-center gap-1">
      <T en="Source on GitHub" zh="GitHub 源码" /> <span aria-hidden="true">→</span>
    </a>

  </div>
</section>

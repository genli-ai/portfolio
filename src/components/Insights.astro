---
import T from './T.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

// Add a report by dropping a .md into src/content/research/ — it shows up here
// automatically and gets its own detail page at /insights/<filename>.
const typeRank = { flagship: 0, note: 1, drafting: 2 } as const;
const entries = (await getCollection('research'))
  .filter((e) => import.meta.env.PROD ? !e.data.draft : true)
  .sort((a, b) =>
    typeRank[a.data.type] - typeRank[b.data.type] ||
    b.data.date.valueOf() - a.data.date.valueOf());

const flagships = entries.filter((e) => e.data.type === 'flagship');
const notes = entries.filter((e) => e.data.type !== 'flagship');

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<section id="insights" class="border-b border-[var(--color-rule)]">
  <div class="max-w-[920px] mx-auto px-7 py-20 md:py-24">

    <div class="text-[11px] font-medium uppercase tracking-[0.18em] text-[var(--color-accent)] mb-3">
      <T en="The living core" zh="持续生长的核心" />
    </div>
    <h2 class="font-serif text-[30px] md:text-[34px] font-semibold tracking-tight mb-3"><T en="Insights" zh="洞察" /></h2>
    <p class="text-[15px] md:text-base text-[var(--color-muted)] leading-relaxed mb-9 max-w-[58ch]">
      <T
        en="My insight reports on Gulf AI-capital — flagship deep-dives plus shorter notes. Each opens to my own read, with the full report in English and 中文."
        zh="我对海湾 AI 资本的洞察报告——旗舰深度 + 短评。点开即是我的判断，全文中英双版可读。"
      />
    </p>

    <!-- Flagship reports: feature cards -->
    <div class="flex flex-col gap-5">
      {flagships.map((e) => {
        const d = e.data;
        return (
          <a href={asset(`insights/${e.id}`)}
             class="group block bg-white border border-[var(--color-rule)] rounded-xl p-6 md:p-8 hover:border-[var(--color-brand)]/50 hover:shadow-[0_8px_30px_-12px_rgba(47,93,80,0.25)] transition">
            <div class="flex items-center gap-3 mb-3.5">
              <span class="text-[10.5px] font-semibold uppercase tracking-[0.1em] bg-[var(--color-brand)] text-white rounded px-2.5 py-1">
                <T en="Flagship Report" zh="旗舰报告" />
              </span>
              <span class="text-[12.5px] text-[var(--color-muted)]">{fmtDate(d.date)}</span>
            </div>
            <h3 class="font-serif text-[21px] md:text-[24px] font-semibold leading-snug tracking-tight mb-3 group-hover:text-[var(--color-brand)] transition">
              <T en={d.title} zh={d.titleZh} />
            </h3>
            {(d.abstractEn || d.summary) && (
              <p class="text-[15px] text-[var(--color-ink-soft)] leading-relaxed line-clamp-2 mb-5 max-w-[64ch]">
                <T en={d.abstractEn ?? d.summary} zh={d.abstractZh ?? d.summaryZh} />
              </p>
            )}
            <div class="flex items-center gap-2 text-[14px] font-medium text-[var(--color-brand)]">
              <T en="Read the report" zh="阅读报告" />
              <span aria-hidden="true" class="group-hover:translate-x-0.5 transition-transform">→</span>
              <span class="ml-1 text-[12px] font-normal text-[var(--color-muted)]">· EN · 中文</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Notes -->
    {notes.length > 0 && (
      <div class="mt-10">
        <div class="text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--color-muted)] mb-1">
          <T en="Notes" zh="短评" />
        </div>
        <div class="flex flex-col">
          {notes.map((e) => {
            const d = e.data;
            const draftish = d.type === 'drafting';
            return (
              <a href={draftish ? undefined : asset(`insights/${e.id}`)}
                 class={`group flex gap-4 sm:gap-5 items-baseline py-[18px] border-t border-[var(--color-rule)] -mx-2 px-2 rounded transition-colors ${draftish ? 'cursor-default' : 'hover:bg-[#fffdf8]'}`}>
                <span class={`text-[10.5px] tracking-[0.08em] uppercase px-2.5 py-[3px] rounded whitespace-nowrap shrink-0 w-[78px] text-center ${draftish ? 'bg-[#f0eee9] text-[#aaa49a]' : 'bg-[#eee9dd] text-[#7a6a45]'}`}>
                  <T en={draftish ? 'Drafting' : 'Note'} zh={draftish ? '撰写中' : '短评'} />
                </span>
                <div class="flex-1 min-w-0">
                  <div class={`text-[16px] font-semibold mb-0.5 ${draftish ? 'text-[#9a948a]' : 'group-hover:text-[var(--color-brand)] transition'}`}>
                    <T en={d.title} zh={d.titleZh} />
                  </div>
                  <div class="text-[13px] text-[var(--color-muted)]"><T en={d.summary} zh={d.summaryZh} /></div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}

  </div>
</section>

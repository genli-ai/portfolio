---
import T from './T.astro';
import SectionHeader from './SectionHeader.astro';
import InsightsFeed from './InsightsFeed.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---
<section id="insights" class="border-b border-[var(--color-rule)]">
  <div class="max-w-[920px] mx-auto px-7 py-20 md:py-28">

    <SectionHeader num="01" kickerEn="The living core" kickerZh="持续生长的核心" titleEn="Insights" titleZh="洞察" />
    <p class="text-[15px] md:text-base text-[var(--color-muted)] leading-relaxed mt-4 mb-9">
      <T
        en="Insight reports on where Gulf capital is betting on AI — flagship deep-dives and shorter notes, updated continuously."
        zh="关于海湾资本在 AI 上押注何处的洞察报告——旗舰深度与短评，持续更新。"
      />
    </p>

    <InsightsFeed showNotes={false} />

    <a href={asset('insights')} class="group inline-flex items-center gap-2 mt-8 text-[14px] font-medium text-[var(--color-brand)]">
      <T en="All insights" zh="全部洞察" />
      <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span>
    </a>

  </div>
</section>

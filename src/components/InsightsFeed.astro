---
import T from './T.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;

interface Props { showNotes?: boolean; }
const { showNotes = true } = Astro.props;

const typeRank = { flagship: 0, note: 1, drafting: 2 } as const;
const entries = (await getCollection('research'))
  .filter((e) => import.meta.env.PROD ? !e.data.draft : true)
  .sort((a, b) =>
    typeRank[a.data.type] - typeRank[b.data.type] ||
    b.data.date.valueOf() - a.data.date.valueOf());

const flagships = entries.filter((e) => e.data.type === 'flagship');
const notes = entries.filter((e) => e.data.type !== 'flagship');
const fmtDate = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<div class="flex flex-col gap-5">
  {flagships.map((e) => {
    const d = e.data;
    return (
      <a href={asset(`insights/${e.id}`)}
         class="group block bg-white border border-[var(--color-rule)] rounded-lg p-7 md:p-9 transition duration-300 hover:border-[var(--color-brand)]/40 hover:shadow-[0_20px_50px_-28px_rgba(47,93,80,0.4)]">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-[10px] font-semibold uppercase tracking-[0.14em] bg-[var(--color-brand)] text-white rounded-sm px-2.5 py-1">
            <T en="Flagship Report" zh="旗舰报告" />
          </span>
          <span class="text-[12.5px] text-[var(--color-muted)]">{fmtDate(d.date)}</span>
        </div>
        <h3 class="font-serif text-[23px] md:text-[28px] font-medium leading-[1.18] tracking-[-0.015em] mb-3.5 group-hover:text-[var(--color-brand)] transition-colors">
          <T en={d.title} zh={d.titleZh} />
        </h3>
        {(d.abstractEn || d.summary) && (
          <p class="text-[15px] text-[var(--color-ink-soft)] leading-relaxed line-clamp-2 mb-6">
            <T en={d.abstractEn ?? d.summary} zh={d.abstractZh ?? d.summaryZh} />
          </p>
        )}
        <span class="inline-flex items-center gap-2 text-[14px] font-medium text-[var(--color-brand)]">
          <T en="Read the report" zh="阅读报告" />
          <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">→</span>
        </span>
      </a>
    );
  })}
</div>

{showNotes && notes.length > 0 && (
  <div class="mt-10">
    <div class="text-[11px] font-medium uppercase tracking-[0.18em] text-[var(--color-muted)] mb-1">
      <T en="Notes" zh="短评" />
    </div>
    <div class="flex flex-col">
      {notes.map((e) => {
        const d = e.data;
        const draftish = d.type === 'drafting';
        return (
          <a href={draftish ? undefined : asset(`insights/${e.id}`)}
             class={`group flex gap-4 sm:gap-5 items-baseline py-5 border-t border-[var(--color-rule)] -mx-2 px-2 rounded transition-colors ${draftish ? 'cursor-default' : 'hover:bg-[#fffdf8]'}`}>
            <span class={`text-[10px] tracking-[0.1em] uppercase px-2.5 py-[3px] rounded-sm whitespace-nowrap shrink-0 w-[76px] text-center ${draftish ? 'bg-[#f0eee9] text-[#aaa49a]' : 'bg-[#eee9dd] text-[#7a6a45]'}`}>
              <T en={draftish ? 'Drafting' : 'Note'} zh={draftish ? '撰写中' : '短评'} />
            </span>
            <div class="flex-1 min-w-0">
              <div class={`text-[16px] font-semibold mb-0.5 ${draftish ? 'text-[#9a948a]' : 'group-hover:text-[var(--color-brand)] transition-colors'}`}>
                <T en={d.title} zh={d.titleZh} />
              </div>
              <div class="text-[13px] text-[var(--color-muted)]"><T en={d.summary} zh={d.summaryZh} /></div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
)}

---
import T from './T.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const links = [
  { href: asset('insights'), en: "Insights", zh: "洞察" },
  { href: asset('skills'), en: "My AI skills", zh: "我的 AI 产品" },
  { href: asset('#about'), en: "About", zh: "关于" },
];
---
<footer class="bg-[var(--color-brand-deep)] text-white">
  <div class="max-w-[920px] mx-auto px-7 py-12">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8 pb-8 border-b border-white/12">
      <div>
        <div class="font-serif text-[26px] leading-none mb-3">Gen<span class="text-[var(--color-accent-soft)]">.</span></div>
        <p class="text-[14px] text-white/55 max-w-[42ch] leading-relaxed">
          <T en="AI investment, strategy &amp; product." zh="AI 投资、战略与产品。" />
        </p>
      </div>
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[14px] text-white/70">
        {links.map(l => (
          <li><a href={l.href} class="hover:text-white transition-colors"><T en={l.en} zh={l.zh} /></a></li>
        ))}
      </ul>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 pt-6 text-[12px] text-white/40">
      <div><T en="© 2026 Gen. All rights reserved." zh="© 2026 Gen. 保留所有权利。" /></div>
      <div class="flex flex-wrap gap-x-6 gap-y-1">
        <a href="https://github.com/genli-ai/market-research-skills" class="hover:text-white/70 transition-colors" target="_blank" rel="noopener"><T en="Open-source tooling · MIT" zh="开源工具 · MIT" /></a>
        <span><T en="Built with Astro · updated May 2026" zh="Astro 构建 · 更新于 2026 年 5 月" /></span>
      </div>
    </div>
  </div>
</footer>

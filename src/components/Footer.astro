---
import T from './T.astro';
---
<footer class="border-t border-[var(--color-rule)]">
  <div class="max-w-[920px] mx-auto px-7 py-8 flex flex-wrap items-center justify-between gap-4 text-xs text-[var(--color-muted)]">
    <div><T en="© 2026 Gen. All rights reserved." zh="© 2026 Gen. 保留所有权利。" /></div>
    <div class="flex flex-wrap gap-x-6 gap-y-1">
      <a href="https://github.com/genli-ai/market-research-skills" class="hover:text-[var(--color-ink)] transition" target="_blank" rel="noopener"><T en="Open-source tooling · MIT" zh="开源工具 · MIT" /></a>
      <span><T en="Built with Astro · last updated May 2026" zh="Astro 构建 · 最后更新 2026 年 5 月" /></span>
    </div>
  </div>
</footer>

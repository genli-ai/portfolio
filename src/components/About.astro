---
import T from './T.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const photo = asset('gen.jpg');
const contacts = [
  { label: { en: "Email", zh: "邮箱" }, href: "mailto:gen.li@sternad.nyu.edu" },
  { label: { en: "LinkedIn", zh: "LinkedIn" }, href: "https://www.linkedin.com/in/gen-li1993/" },
  { label: { en: "GitHub", zh: "GitHub" }, href: "https://github.com/genli-ai" },
];
const meta = [
  { label: { en: "Seeking", zh: "求职方向" },
    en: "AI investment, strategy & product roles · Gulf tech firms & market-driven funds",
    zh: "AI 投资 / 战略 / 产品岗 · 海湾科技公司与市场化基金" },
  { label: { en: "Edge", zh: "优势" },
    en: "the China–Gulf corridor — capital and AI moving both directions",
    zh: "中国—海湾走廊 —— 资本与 AI 的双向流动" },
  { label: { en: "Languages", zh: "语言" },
    en: "Mandarin (native) · English (fluent)",
    zh: "中文（母语）· 英文（流利）" },
];
---
<section id="about">
  <div class="max-w-[920px] mx-auto px-7 py-20 md:py-24">

    <div class="text-[11px] font-medium uppercase tracking-[0.18em] text-[var(--color-accent)] mb-3">
      <T en="Who I am" zh="我是谁" />
    </div>
    <h2 class="font-serif text-[30px] md:text-[34px] font-semibold tracking-tight mb-9"><T en="About" zh="关于" /></h2>

    <div class="flex flex-col sm:flex-row gap-8 mb-10">
      <div class="w-[140px] h-[176px] rounded-xl overflow-hidden shrink-0 bg-[#ece7db] flex items-center justify-center text-[#b7afa0] text-xs relative">
        <span class="absolute">photo</span>
        <img src={photo} alt="Gen Li" loading="lazy"
             class="relative w-full h-full object-cover object-top"
             onerror="this.style.display='none'" />
      </div>
      <div class="flex-1">
        <p class="text-[var(--color-ink-soft)] text-[16px] md:text-[17px] leading-relaxed mb-6 max-w-[60ch]">
          <T
            en="Gen — NYU Abu Dhabi '26. I work the seam between Chinese capital & technology and the Gulf: bilingual, in-region, and unusually AI-native for a research analyst."
            zh="Gen — NYU Abu Dhabi '26。我站在中国资本与技术、海湾市场的接缝处：双语、在地，且作为一名研究分析师罕见地 AI-native。"
          />
        </p>
        <dl class="flex flex-col gap-3">
          {meta.map((m) => (
            <div class="grid grid-cols-[88px_1fr] gap-3 text-sm">
              <dt class="text-[var(--color-accent)] font-medium uppercase tracking-wide text-[11px] pt-0.5"><T en={m.label.en} zh={m.label.zh} /></dt>
              <dd class="text-[var(--color-ink-soft)]"><T en={m.en} zh={m.zh} /></dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="border-t border-[var(--color-rule)] pt-7">
      <div class="font-serif text-[18px] text-[var(--color-ink)] mb-3"><T en="Let's talk." zh="聊聊。" /></div>
      <div class="flex flex-wrap gap-2.5">
        {contacts.map((c) => (
          <a href={c.href} target="_blank" rel="noopener"
             class="inline-flex items-center px-4 py-2 rounded-full border border-[var(--color-rule)] bg-white text-[14px] text-[var(--color-brand)] hover:border-[var(--color-brand)] hover:bg-[var(--color-brand)]/[0.04] transition">
            <T en={c.label.en} zh={c.label.zh} />
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

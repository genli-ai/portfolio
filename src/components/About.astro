---
import T from './T.astro';
import SectionHeader from './SectionHeader.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const photo = asset('gen.jpg');
const contacts = [
  { label: { en: "Email", zh: "邮箱" }, href: "mailto:gen.li@sternad.nyu.edu" },
  { label: { en: "LinkedIn", zh: "LinkedIn" }, href: "https://www.linkedin.com/in/gen-li1993/" },
  { label: { en: "GitHub", zh: "GitHub" }, href: "https://github.com/genli-ai" },
];
const meta = [
  { label: { en: "Seeking", zh: "求职方向" },
    en: "AI investment, strategy & product growth · Gulf tech firms & market-driven funds",
    zh: "AI 投资、战略与产品增长 · 海湾科技公司与市场化基金" },
  { label: { en: "Edge", zh: "优势" },
    en: "the China–Gulf corridor — capital and AI moving both directions",
    zh: "中国—海湾走廊 —— 资本与 AI 的双向流动" },
  { label: { en: "Languages", zh: "语言" },
    en: "Mandarin (native) · English (fluent) · French (fluent)",
    zh: "中文（母语）· 英文（流利）· 法语（流利）" },
];
---
<section id="about">
  <div class="max-w-[920px] mx-auto px-7 py-20 md:py-28">

    <SectionHeader num="03" kickerEn="Who I am" kickerZh="我是谁" titleEn="About" titleZh="关于" />

    <div class="flex flex-col sm:flex-row gap-8 md:gap-12 mt-10 mb-10">
      <div class="w-[152px] h-[190px] rounded-xl overflow-hidden shrink-0 bg-[#ece7db] flex items-center justify-center text-[#b7afa0] text-xs relative ring-1 ring-[var(--color-rule)] shadow-[0_18px_40px_-22px_rgba(26,29,26,0.4)]">
        <span class="absolute">photo</span>
        <img src={photo} alt="Gen" loading="lazy"
             class="relative w-full h-full object-cover object-top"
             onerror="this.style.display='none'" />
      </div>
      <div class="flex-1">
        <p class="text-[var(--color-ink-soft)] text-[17px] md:text-[18px] leading-[1.65] mb-7">
          <T
            en="Gen — an NYU Abu Dhabi '26 MBA, based in the Gulf. I study how capital and AI flow across the China–Gulf corridor, and I build AI products myself — pairing in-region, bilingual insight with hands-on technical fluency."
            zh="Gen —— NYU Abu Dhabi '26 MBA，常驻海湾。我研究资本与 AI 如何在中国—海湾走廊间流动，也亲手打造 AI 产品——把在地、双语的洞察，与动手做产品的技术能力结合在一起。"
          />
        </p>
        <dl class="flex flex-col">
          {meta.map((m) => (
            <div class="grid grid-cols-[94px_1fr] gap-4 py-3 border-t border-[var(--color-rule)] text-sm">
              <dt class="text-[var(--color-accent)] font-semibold uppercase tracking-[0.1em] text-[10.5px] pt-1"><T en={m.label.en} zh={m.label.zh} /></dt>
              <dd class="text-[var(--color-ink-soft)] leading-relaxed"><T en={m.en} zh={m.zh} /></dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="border-t border-[var(--color-rule)] pt-8">
      <div class="font-serif text-[22px] text-[var(--color-ink)] mb-4"><T en="Let's talk." zh="聊聊。" /></div>
      <div class="flex flex-wrap gap-2.5">
        {contacts.map((c) => (
          <a href={c.href} target="_blank" rel="noopener"
             class="inline-flex items-center px-4 py-2 rounded-full border border-[var(--color-rule)] bg-white text-[14px] text-[var(--color-brand)] hover:border-[var(--color-brand)] hover:bg-[var(--color-brand)]/[0.05] transition">
            <T en={c.label.en} zh={c.label.zh} />
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

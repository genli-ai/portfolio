---
import T from './T.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const downloads = [
  { href: asset('reports/gcc-swf-ai-pivot-en.html'), labelEn: "Read the report (English)", labelZh: "阅读报告（英文）", metaEn: "HTML · opens in browser", metaZh: "HTML · 浏览器打开" },
  { href: asset('reports/gcc-swf-ai-pivot-zh.html'), labelEn: "Read the report (Chinese)", labelZh: "阅读报告（中文）", metaEn: "HTML · 浏览器打开", metaZh: "中文 · 浏览器打开" },
];
---
<section id="case" class="bg-[var(--color-paper-warm)] border-y border-[var(--color-rule)]">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">

    <div class="max-w-3xl mb-10">
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--color-accent)] mb-4">
        <T en="Proof · built with the skill" zh="实证 · 这个 skill 跑出来的" />
      </div>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight leading-tight mb-6">
        <T en="GCC sovereign wealth funds and the AI-capital pivot, 2023–2026" zh="海湾主权财富基金与 AI 资本转向，2023–2026" /><span class="text-[var(--color-accent)]">.</span>
      </h2>
      <p class="text-[var(--color-muted)] leading-relaxed">
        <T
          en="Produced end-to-end in heavy mode, with every number traceable to a primary source. Read the full report in your browser — English or Chinese."
          zh="整篇用 heavy mode 从头跑到尾，每个数字都追得到原始来源。完整报告可直接在浏览器里阅读——中文或英文。"
        />
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 max-w-2xl">
      {downloads.map(d => (
        <a
          href={d.href}
          target="_blank" rel="noopener"
          class="group flex flex-col gap-1 p-5 rounded-lg border border-[var(--color-rule)] bg-white hover:border-[var(--color-ink)] hover:shadow-lg transition"
        >
          <span class="text-base font-semibold text-[var(--color-ink)] flex items-center justify-between">
            <T en={d.labelEn} zh={d.labelZh} />
            <span class="text-[var(--color-accent)] group-hover:translate-x-0.5 transition-transform" aria-hidden="true">↗</span>
          </span>
          <span class="text-xs font-mono text-[var(--color-muted)]"><T en={d.metaEn} zh={d.metaZh} /></span>
        </a>
      ))}
    </div>

  </div>
</section>

---
import T from './T.astro';
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const downloads = [
  { href: asset('reports/saudi-vision-2030-exec-summary-en.pdf'), labelEn: "Executive summary", labelZh: "执行摘要", metaEn: "English · 7 pages", metaZh: "英文 · 7 页" },
  { href: asset('reports/saudi-vision-2030-report-en.pdf'), labelEn: "Full report (English)", labelZh: "完整英文报告", metaEn: "English · 55 pages", metaZh: "英文 · 55 页" },
  { href: asset('reports/saudi-vision-2030-report.pdf'), labelEn: "Full report (Chinese)", labelZh: "完整中文报告", metaEn: "中文 · 50 页", metaZh: "中文 · 50 页" },
];
---
<section id="case" class="bg-[var(--color-paper-warm)] border-y border-[var(--color-rule)]">
  <div class="max-w-6xl mx-auto px-6 py-20 md:py-28">

    <div class="max-w-3xl mb-10">
      <div class="text-xs font-mono uppercase tracking-[0.2em] text-[var(--color-accent)] mb-4">
        <T en="Proof · built with the skill" zh="实证 · 这个 skill 跑出来的" />
      </div>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight leading-tight mb-6">
        <T en="A 15,000-word Saudi Vision 2030 deep-dive" zh="一份 1.5 万字的沙特愿景 2030 深度研究" /><span class="text-[var(--color-accent)]">.</span>
      </h2>
      <p class="text-[var(--color-muted)] leading-relaxed">
        <T
          en="Produced end-to-end in heavy mode, with every number traceable to a primary source (IMF, GASTAT, SAMA, MoF, PIF, IIF). The example library is being rebuilt — this one stands in as the current reference deliverable."
          zh="整篇用 heavy mode 从头跑到尾，每个数字都追得到原始来源（IMF、GASTAT、SAMA、MoF、PIF、IIF）。示例库正在重做，这篇先当作目前的参考成稿。"
        />
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-4 max-w-4xl">
      {downloads.map(d => (
        <a
          href={d.href}
          target="_blank" rel="noopener"
          class="group flex flex-col gap-1 p-5 rounded-lg border border-[var(--color-rule)] bg-white hover:border-[var(--color-ink)] hover:shadow-lg transition"
        >
          <span class="text-base font-semibold text-[var(--color-ink)] flex items-center justify-between">
            <T en={d.labelEn} zh={d.labelZh} />
            <span class="text-[var(--color-accent)] group-hover:translate-y-0.5 transition-transform" aria-hidden="true">↓</span>
          </span>
          <span class="text-xs font-mono text-[var(--color-muted)]"><T en={d.metaEn} zh={d.metaZh} /></span>
        </a>
      ))}
    </div>

  </div>
</section>

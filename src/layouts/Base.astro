---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Ligen · AI for Finance, MENA",
  description = "Portfolio of Ligen — building AI-augmented investment research workflows. Saudi Vision 2030 deep-dive case study + open-source Claude skill (analyst-research)."
} = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-ink)]">
    <slot />
  </body>
</html>

---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Gen — AI × Gulf Capital",
  description = "Gen — I analyze where Gulf capital is betting on AI, and I build AI products of my own. Investment & AI-application research, Middle East. NYU Abu Dhabi '26. Open to AI investment, strategy & product roles in the UAE & KSA."
} = Astro.props;
const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <script is:inline>
      // Pre-paint: apply saved language before first render to avoid a flash.
      (function () {
        var saved = localStorage.getItem('lang');
        var lang = saved === 'zh' ? 'zh' : 'en';
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      })();
    </script>
  </head>
  <body class="bg-[var(--color-paper)] text-[var(--color-ink)]">
    <slot />
    <script>
      document.querySelectorAll('[data-lang-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = document.documentElement.dataset.lang === 'zh' ? 'en' : 'zh';
          document.documentElement.dataset.lang = next;
          document.documentElement.lang = next;
          localStorage.setItem('lang', next);
        });
      });
    </script>
  </body>
</html>
